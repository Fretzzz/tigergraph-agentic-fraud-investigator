{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string"
    },
    "case": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "open",
            "closed_fraud",
            "closed_legitimate",
            "escalated"
          ]
        },
        "verdict": {
          "type": "string",
          "enum": [
            "fraud",
            "legitimate",
            "uncertain"
          ]
        },
        "fraud_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pattern": {
          "type": "string",
          "enum": [
            "card_testing",
            "card_not_present_fraud",
            "card_not_present_new_device",
            "out_of_region_use",
            "account_takeover",
            "undocumented",
            "none"
          ]
        },
        "pattern_description": {
          "type": "string"
        },
        "affected_txn_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "first_suspicious_txn_id": {
          "type": "string"
        },
        "connected_card_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "connected_device_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exposure_usd": {
          "type": "number",
          "minimum": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "enum": [
                  "graph",
                  "document",
                  "customer",
                  "external"
                ]
              },
              "ref": {
                "type": "string"
              },
              "entity_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "claim",
              "source",
              "ref",
              "entity_ids"
            ],
            "additionalProperties": false
          }
        },
        "similar_prior_cases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        },
        "written_to_graph": {
          "type": "boolean"
        },
        "graph_case_id": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "verdict",
        "fraud_probability",
        "pattern",
        "pattern_description",
        "affected_txn_ids",
        "first_suspicious_txn_id",
        "connected_card_ids",
        "connected_device_profiles",
        "exposure_usd",
        "evidence",
        "similar_prior_cases",
        "summary",
        "written_to_graph",
        "graph_case_id"
      ],
      "additionalProperties": false
    },
    "evidence_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "customer_validation",
              "step_up_auth",
              "analyst_info"
            ]
          },
          "asked_after_step": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "assumed_response": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "asked_after_step",
          "assumed_response"
        ],
        "additionalProperties": false
      }
    },
    "next_best_actions": {
      "type": "object",
      "properties": {
        "initial": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "ALLOW_TRANSACTION",
                  "DECLINE_TRANSACTION",
                  "MONITOR_CARD",
                  "MONITOR_CONNECTED_CARDS",
                  "WARN_CUSTOMER",
                  "VERIFY_WITH_CUSTOMER",
                  "STEP_UP_AUTH",
                  "BLOCK_CARD",
                  "BLOCK_ALL_CARDS",
                  "GENERATE_REPORT",
                  "CREATE_CASE",
                  "FILE_REPORT",
                  "ESCALATE_TO_ANALYST",
                  "CLOSE_NO_FRAUD"
                ]
              },
              "route": {
                "type": "string",
                "enum": [
                  "auto",
                  "L1",
                  "L2"
                ]
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "action",
              "route",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "final": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "ALLOW_TRANSACTION",
                  "DECLINE_TRANSACTION",
                  "MONITOR_CARD",
                  "MONITOR_CONNECTED_CARDS",
                  "WARN_CUSTOMER",
                  "VERIFY_WITH_CUSTOMER",
                  "STEP_UP_AUTH",
                  "BLOCK_CARD",
                  "BLOCK_ALL_CARDS",
                  "GENERATE_REPORT",
                  "CREATE_CASE",
                  "FILE_REPORT",
                  "ESCALATE_TO_ANALYST",
                  "CLOSE_NO_FRAUD"
                ]
              },
              "route": {
                "type": "string",
                "enum": [
                  "auto",
                  "L1",
                  "L2"
                ]
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "action",
              "route",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "what_changed": {
          "type": "string"
        }
      },
      "required": [
        "initial",
        "final",
        "what_changed"
      ],
      "additionalProperties": false
    },
    "sar": {
      "type": "object",
      "properties": {
        "file": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "narrative": {
          "type": "string"
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "total_amount_usd": {
          "type": "number",
          "minimum": 0
        },
        "activity_dates": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": []
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
                },
                {
                  "type": "string",
                  "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
                }
              ]
            }
          ]
        }
      },
      "required": [
        "file",
        "reason",
        "narrative",
        "subjects",
        "total_amount_usd",
        "activity_dates"
      ],
      "additionalProperties": false
    },
    "stop_reason": {
      "type": "string"
    },
    "tool_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "latency_s": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "case_id",
    "case",
    "evidence_requests",
    "next_best_actions",
    "sar",
    "stop_reason",
    "tool_calls",
    "tokens",
    "latency_s"
  ],
  "additionalProperties": false,
  "$id": "https://graphsentinel.local/schema/answer.schema.json"
}
