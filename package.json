{
  "name": "graphsentinel",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "doctor": "tsx scripts/doctor.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:worker": "vitest run --passWithNoTests tests/worker",
    "test:e2e": "vitest run --passWithNoTests tests/e2e",
    "test:live": "tsx scripts/require-live-target.ts",
    "build": "tsc --noEmit",
    "verify:release": "tsx scripts/verify-release.ts",
    "probe:providers": "tsx scripts/probe-providers.ts",
    "case:slice": "uv run --project pipelines python -m fraud_data.case_slice",
    "case:run": "tsx scripts/run-case.ts",
    "web": "python3 -m http.server 8765 --directory apps/web"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "type": "module",
  "dependencies": {
    "zod": "4.1.11"
  }
}
